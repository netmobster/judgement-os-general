{
  "description": "Stamps the time on every prompt and says when a check-in is due.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/clock.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
